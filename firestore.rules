rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: /projects/{projectId}
// Document ID: {projectId} (slug or unique identifier)
// Fields:
//   - id: string (required, 1..100 chars, immutable on update) - Unique project identifier
//   - title: string (required, 1..200 chars) - Project display title
//   - subtitle: string (required, 1..300 chars) - Project subtitle / tagline
//   - category: string (required, 1..100 chars) - Project category label
//   - shapeType: string (required, enum: ['hexagon', 'circle', 'square', 'clover']) - Physics hero geometry
//   - color: string (required, 1..50 chars) - Primary CSS/hex color
//   - accentTextColor: string (optional, 0..50 chars) - Optional contrast text color
//   - summary: string (required, 1..1000 chars) - Short card summary
//   - description: string (required, 1..10000 chars) - Full case-study description
//   - keyFeatures: list (required, max 50 items) - Bullet list of key technical features
//   - tags: list (required, max 50 items) - Technology and topic tags
//   - demoUrl: string (optional, 0..1000 chars) - Live demo URL
//   - githubUrl: string (optional, 0..1000 chars) - Source repository URL
//   - coverImage: string (optional, 0..2000 chars) - Cover image URL or path
//   - galleryImages: list (optional, max 20 items) - Array of gallery image URLs
//   - metrics: list (optional, max 20 items) - Array of { label, value } metric objects
//   - year: string (required, 1..20 chars) - Project release/completion year
//   - published: bool (required) - Whether project is visible on the public site
//   - featuredOnMobile: bool (required) - Whether project is included in the mobile physics cap
//   - order: int | float (required, -10000..100000) - Display sort order
//   - createdAt: timestamp | int | float | string (optional, immutable on update) - Creation timestamp
//   - updatedAt: timestamp | int | float | string (optional) - Last modification timestamp
//
// Document: /settings/site
// Document ID: site (singleton configuration document)
// Fields:
//   - brandName: string (required, 1..100 chars) - Portfolio header brand title
//   - aboutBadge: string (optional, 0..100 chars) - About modal pill badge text
//   - aboutTitle: string (optional, 0..200 chars) - About modal heading
//   - aboutParagraphs: list (optional, max 20 items) - About modal body paragraphs
//   - contactEmail: string (optional, 0..254 chars) - Public contact email address
//   - socialLinks: map | list (optional, max 20 entries) - Public social profile URLs
//   - adminWhitelistEmails: list (optional, max 50 items) - Authorized admin email addresses
//   - createdAt: timestamp | int | float | string (optional, immutable on update) - Creation timestamp
//   - updatedAt: timestamp | int | float | string (optional) - Last modification timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is owner based on document's uid field
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Check if the user has a verified email address on their auth token
    function isVerifiedAdminToken() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }

    // Check if the authenticated user is an authorized portfolio administrator.
    // Enforces verified email token + optional whitelist check in /settings/site.
    function isAdmin() {
      let settingsPath = /databases/$(database)/documents/settings/site;
      return isVerifiedAdminToken() && (
        !exists(settingsPath) ||
        !('adminWhitelistEmails' in get(settingsPath).data) ||
        !(get(settingsPath).data.adminWhitelistEmails is list) ||
        get(settingsPath).data.adminWhitelistEmails.size() == 0 ||
        request.auth.token.email in get(settingsPath).data.adminWhitelistEmails
      );
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string (if present, must be string and within length)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate that a list is a list and enforces size limits
    function isValidList(listData, maxSize) {
      return listData is list && listData.size() <= maxSize;
    }

    // Validate optional timestamp/date metadata field
    function isValidOptionalTimestamp(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] is timestamp ||
        request.resource.data[field] is int ||
        request.resource.data[field] is float ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= 100);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidProject(data) {
      let requiredFields = [
        'id',
        'title',
        'subtitle',
        'category',
        'shapeType',
        'color',
        'summary',
        'description',
        'year',
        'published',
        'featuredOnMobile',
        'order',
        'keyFeatures',
        'tags'
      ];
      let allowedFields = [
        'id',
        'title',
        'subtitle',
        'category',
        'shapeType',
        'color',
        'accentTextColor',
        'summary',
        'description',
        'keyFeatures',
        'tags',
        'demoUrl',
        'githubUrl',
        'coverImage',
        'galleryImages',
        'metrics',
        'year',
        'published',
        'featuredOnMobile',
        'order',
        'createdAt',
        'updatedAt'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('id', 1, 100) &&
        validStringLength('title', 1, 200) &&
        validStringLength('subtitle', 1, 300) &&
        validStringLength('category', 1, 100) &&
        data.shapeType is string &&
        data.shapeType in ['hexagon', 'circle', 'square', 'clover'] &&
        validStringLength('color', 1, 50) &&
        validStringLength('summary', 1, 1000) &&
        validStringLength('description', 1, 10000) &&
        validStringLength('year', 1, 20) &&
        data.published is bool &&
        data.featuredOnMobile is bool &&
        (data.order is int || data.order is float) &&
        data.order >= -10000 &&
        data.order <= 100000 &&
        isValidList(data.keyFeatures, 50) &&
        isValidList(data.tags, 50) &&
        isValidOptionalString('accentTextColor', 0, 50) &&
        isValidOptionalString('demoUrl', 0, 1000) &&
        isValidOptionalString('githubUrl', 0, 1000) &&
        isValidOptionalString('coverImage', 0, 2000) &&
        (!('galleryImages' in data) || isValidList(data.galleryImages, 20)) &&
        (!('metrics' in data) || isValidList(data.metrics, 20)) &&
        isValidOptionalTimestamp('createdAt') &&
        isValidOptionalTimestamp('updatedAt');
    }

    function isValidSiteSettings(data) {
      let requiredFields = ['brandName'];
      let allowedFields = [
        'brandName',
        'aboutBadge',
        'aboutTitle',
        'aboutParagraphs',
        'contactEmail',
        'socialLinks',
        'adminWhitelistEmails',
        'createdAt',
        'updatedAt'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('brandName', 1, 100) &&
        isValidOptionalString('aboutBadge', 0, 100) &&
        isValidOptionalString('aboutTitle', 0, 200) &&
        (!('aboutParagraphs' in data) || isValidList(data.aboutParagraphs, 20)) &&
        isValidOptionalString('contactEmail', 0, 254) &&
        (!('socialLinks' in data) ||
          (data.socialLinks is map && data.socialLinks.keys().size() <= 20) ||
          isValidList(data.socialLinks, 20)) &&
        (!('adminWhitelistEmails' in data) || isValidList(data.adminWhitelistEmails, 50)) &&
        isValidOptionalTimestamp('createdAt') &&
        isValidOptionalTimestamp('updatedAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Portfolio Projects Collection
    match /projects/{projectId} {
      // Public visitors can read/list portfolio projects
      allow read: if true;

      // Only verified administrators can create, update, or delete projects
      allow create: if isAdmin() &&
        isValidProject(request.resource.data);

      allow update: if isAdmin() &&
        isValidProject(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if isAdmin();
    }

    // Singleton Site Settings Document
    match /settings/site {
      // Public visitors can read site configuration (brandName, about modal, social links)
      allow read: if true;

      // Only verified administrators can create or update site settings
      allow create: if isAdmin() &&
        isValidSiteSettings(request.resource.data);

      allow update: if isAdmin() &&
        isValidSiteSettings(request.resource.data) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if false;
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
